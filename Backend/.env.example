PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Add additional frontend origins as comma separated URLs when needed.
CLIENT_URLS=http://localhost:5174
MONGO_URI=mongodb://127.0.0.1:27017/blanco_academy
# Replace with a unique, random secret before deployment.
JWT_SECRET=replace-with-a-long-random-secret

# Used once by `npm run seed:admin` to create the first admin account.
ADMIN_NAME=Academy Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Production uploads use Cloudinary. Keep these out of source control.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
COOKIE_SAME_SITE=lax
# Set to 1 when deployed behind one trusted reverse proxy.
TRUST_PROXY=0
